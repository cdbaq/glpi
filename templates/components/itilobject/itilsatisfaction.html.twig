{% import "components/form/fields_macros.html.twig" as fields %}

{{ call_plugin_hook(constant('Glpi\\Plugin\\Hooks::PRE_ITEM_FORM'), {"item": item, 'options': params}) }}
{% block more_fields %}
  {% if url is defined %}
    {{ fields.htmlField(
      '',
      '<a href="' ~ url|escape ~ '">' ~ url|escape ~ '</a>',
      ('External survey'),
    ) }}
  {% else %}
    {% if expired is defined %}
      {% if expired %}
        {{ fields.htmlField('', __('Satisfaction survey expired.') ) }}
      {% else %}
        {{ fields.htmlField('', __('After 12 hours, you can no longer modify your response.') ) }}
      {% endif %}
    {% endif %}

    /*
    {% if item.fields['date_answered'] is empty and expired %}
      {{ fields.htmlField(
        {
          '...',
          '...',
        },
        ('No response given'),
      ) }}
    {% endif %}
    */

    <twig:Alert
      imessage="message"
      />
  {% endif %}
{% endblock more_fields %}
